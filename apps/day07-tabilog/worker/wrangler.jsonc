{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tabilog-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGIN": "https://ainaraomakaseare-coder.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tabilog-db",
      "database_id": "9c69d573-f2c3-4105-8b97-ba3ba49119b1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS_BUCKET",
      "bucket_name": "tabilog-photos"
    }
  ],
  // Workers AIとOpenAIを比べる試作（docs/adr/0012）用。バインディングを追加するだけで
  // 費用は発生しない（呼び出したときだけNeuronsを消費する）。
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "WRITE_RATE_LIMITER",
      "namespace_id": "51019",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "51020",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
