{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tabilog-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // カンマ区切りで複数指定できる（isAllowedOrigin/cors、src/cors.js）。
    // GitHub PagesからCloudflare Pagesへの移行期間中は両方を許可する（2026-09-29〜）。
    "ALLOWED_ORIGIN": "https://ainaraomakaseare-coder.github.io,https://tabinoashiato.pages.dev",
    // なりすまし対策（docs/adr/0005）：ログインの証明（セッショントークン）が無い操作は断る（2026-09-30 オン）。
    "REQUIRE_SESSION": "1",
    "GOOGLE_CLIENT_ID": "7412131942-ncahcn0f4kpt7b07br0sh46lm8at98hm.apps.googleusercontent.com",
    "APPLE_SERVICES_ID": "com.hiroyaapps.tabilog.web",
    "APPLE_TEAM_ID": "594N82AW44",
    "APPLE_KEY_ID": "X22A8BN456"
    // ソーシャルログイン（Apple・Google・LINE。docs/adr/0019）の設定。各社のコンソールで登録して
    // IDが分かってから、ここに書き足す（設定した方式だけログイン画面にボタンが出る。手順はREADME.md）。
    // 秘密のもの（GOOGLE_CLIENT_SECRET・APPLE_PRIVATE_KEY・LINE_CHANNEL_SECRET）はここに書かず
    // `npx wrangler secret put` で登録する。
    // , "GOOGLE_CLIENT_ID": "…apps.googleusercontent.com"
    // , "APPLE_SERVICES_ID": "com.hiroyaapps.tabilog.web"
    // , "APPLE_TEAM_ID": "…"
    // , "APPLE_KEY_ID": "…"
    // , "LINE_CHANNEL_ID": "…"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tabilog-db",
      "database_id": "9c69d573-f2c3-4105-8b97-ba3ba49119b1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS_BUCKET",
      "bucket_name": "tabilog-photos"
    }
  ],
  // Workers AIとOpenAIを比べる試作（docs/adr/0012）用。バインディングを追加するだけで
  // 費用は発生しない（呼び出したときだけNeuronsを消費する）。
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "WRITE_RATE_LIMITER",
      "namespace_id": "51019",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "51020",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
