<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 共有リンク（?trip=…）をアプリで開くためのユニバーサルリンク設定。
	     CIで毎回 ios/App/App/App.entitlements にコピーされる（.github/workflows/tabilog-ios-build.yml）。
	     2026-09-29〜：公開先をGitHub PagesからCloudflare Pagesへ移行するのに合わせて
	     tabinoashiato.pages.devを追加。旧ホスト（github.io）も移行完了まで残す。 -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:tabinoashiato.pages.dev</string>
		<string>applinks:ainaraomakaseare-coder.github.io</string>
	</array>
</dict>
</plist>
