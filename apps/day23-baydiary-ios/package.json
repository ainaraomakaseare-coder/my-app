{
  "name": "baydiary-ios",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "ios:add": "npm run build && cap add ios && node scripts/configure-ios.mjs",
    "sync": "npm run build && cap sync ios && node scripts/configure-ios.mjs",
    "test": "node --test test/*.test.mjs",
    "check:workflow": "node scripts/check-workflow.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.25.0",
    "plist": "^3.1.0",
    "sharp": "^0.35.4",
    "xcode": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
