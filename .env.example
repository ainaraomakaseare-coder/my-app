# ---------------------------------------------------------------
# このファイルをコピーして .env を作ってください。
#   cp .env.example .env
#
# .env は .gitignore に入っているので GitHub には上がりません。
# 中身は絶対に人に見せない・貼らない・スクショに写さないでください。
# ---------------------------------------------------------------

# Meta の管理画面 → アプリ設定 → ベーシック の「Instagram App Secret」
# 短期トークンを60日の長期トークンに交換するときに使います。
IG_APP_SECRET=

# アクセストークン。画面の「連携設定」から登録すると、ここに自動で書き込まれます。
# 手で書いても構いません。
IG_ACCESS_TOKEN=

# 長期トークンの有効期限（アプリが自動で入れます。手で触らなくて大丈夫です）
IG_TOKEN_EXPIRES_AT=

# Cloudflare トンネルで表示された https の URL。
# 画面の「連携設定」から入れてもよく、その場合はここは空のままで構いません。
PUBLIC_BASE_URL=

# ポート（変える必要がなければそのままで大丈夫です）
PORT=3000
MEDIA_PORT=3001
